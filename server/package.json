{
  "name": "websocket-chat-server",
  "version": "1.0.0",
  "description": "Real-time WebSocket chat server with JWT auth (Express + ws + PostgreSQL)",
  "main": "dist/src/index.js",
  "scripts": {
    "dev:watch": "tsc -w",
    "start:watch": "nodemon dist/src/index.js",
    "dev:hot": "concurrently \"npm run dev:watch\" \"npm run start:watch\"",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "npm run build && node --test dist/test/utils.test.js dist/test/tickets.test.js",
    "test:db": "node scripts/test-db.mjs up",
    "test:db:down": "node scripts/test-db.mjs down",
    "test:integration": "npm run test:db && npm run build && node scripts/run-integration.mjs",
    "test": "npm run test:unit && npm run test:integration"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sentry/node": "^10.19.0",
    "@sentry/profiling-node": "^10.19.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemon": "^3.1.10",
    "pg": "^8.16.3",
    "winston": "^3.18.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "supertest": "^7.3.0",
    "typescript": "^5.9.2"
  }
}
